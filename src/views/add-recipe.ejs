<%- include('partials/header') %>

<section class="featured">
    <div style="max-width: 600px; margin: 0 auto; background: white; padding: 2.5rem; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
        
        <h2 style="margin-bottom: 1.5rem; text-align: center;">Bæta við nýrri uppskrift</h2>
        
        <form action="/uppskriftir/ny" method="POST" style="display: flex; flex-direction: column; gap: 1.5rem;">
            
            <div>
                <label for="title" style="font-weight: 600; display: block; margin-bottom: 0.5rem;">Nafn uppskriftar *</label>
                <input type="text" id="title" name="title" required style="width: 100%; padding: 0.8rem; border: 1px solid #ccc; border-radius: 6px; font-family: inherit;">
            </div>

            <div>
                <label for="time_minutes" style="font-weight: 600; display: block; margin-bottom: 0.5rem;">Eldunartími (í mínútum)</label>
                <input type="number" id="time_minutes" name="time_minutes" placeholder="T.d. 45" style="width: 100%; padding: 0.8rem; border: 1px solid #ccc; border-radius: 6px; font-family: inherit;">
            </div>

            <div>
                <label for="image_url" style="font-weight: 600; display: block; margin-bottom: 0.5rem;">Slóð á mynd (valfrjálst)</label>
                <input type="text" id="image_url" name="image_url" placeholder="https://..." style="width: 100%; padding: 0.8rem; border: 1px solid #ccc; border-radius: 6px; font-family: inherit;">
            </div>

            <button type="submit" class="btn-primary" style="padding: 1rem; background-color: #ff6b6b; color: white; border: none; border-radius: 50px; font-size: 1.1rem; font-weight: 600; cursor: pointer; margin-top: 1rem;">
                Vista uppskrift
            </button>
        </form>

    </div>
</section>

<%- include('partials/footer') %>
